{
  "name": "@frontier-commerce/indexer",
  "version": "0.1.4",
  "private": true,
  "license": "Apache-2.0",
  "description": "Event indexer: polls frontier-commerce events into a SQLite ledger and prints accounting reports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frontier-commerce/sdk": "workspace:*",
    "@mysten/sui": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@frontier-commerce/gas-station",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "Sponsorship (gas station) service: validates TransactionKinds against an allowlist policy, attaches sponsor gas from a reserved coin pool, co-signs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@mysten/sui": "^2.22.0",
    "@protobuf-ts/grpc-transport": "^2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
